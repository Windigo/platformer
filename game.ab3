; ---------------------------------------------------------------
; game.ab3 -- Multi-level game via Tiled2Retro
; 3 levels beschikbaar (level 0..2)
; Pas #CURRENT_LEVEL aan om een ander level te laden
; ---------------------------------------------------------------

; ==== HIER KIES JE HET LEVEL ====
#CURRENT_LEVEL = 0
#TOTAL_LEVELS  = 3


INCDIR "includes/"
XINCLUDE "map.ab3"
XINCLUDE "player.ab3"

BLITZ
BlitzKeys On


Slice 0,44,3

Use Slice 0
Use Palette 0


front_buffer.l = 1
back_buffer.l = 2



; ==============================================================
; Game loop
; ==============================================================

Repeat

  VWait

  Show back_buffer

  Use Palette 0

  Exchange  front_buffer, back_buffer
  Use BitMap back_buffer

  ; --- Joystick input ---
  jx = Joyx(1)
  jy = Joyy(1)
  jb = Joyb(1)



  ; --- Render sprite ---
  ShowSprite 0, player\x, player\y, 0

  VWait


Until RawStatus(16)   ; quit on Q

AMIGA
End
