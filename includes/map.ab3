; /XTRA
; -----------------------------------------------------------------------
; mapinit.ab3 -- Map initializition of maps generated using Tiled2Retro
; -----------------------------------------------------------------------

; --- Constantes ---
#MAP_COLS       = 20
#MAP_ROWS       = 16
#TILE_SIZE      = 16
#CELLS          = 320
#SHEET_COLS     = 49
#SHEET_W        = 784
#SHEET_H        = 352
#BITPLANES      = 3
#SPRITE_TILE    = 459
#SPRITE_SRCX    = 288
#SPRITE_SRCY    = 144

#FLAG_FLOOR  = 1
#FLAG_WALL   = 2
#FLAG_LADDER = 4
#MAX_VY      = 6

; --- Arrays ---
Dim tilemap.w(#CELLS)
Dim tileflags.w(#CELLS)

; ==============================================================
; AMIGA mode: load tilesheet + data + build BitMap
; ==============================================================

; --- Load tilesheet IFF ---
BitMap 0, #SHEET_W, #SHEET_H, #BITPLANES
LoadBitMap 0, "assets/tiles_3bp.iff", 0
BitMap 1, 320,256,#BITPLANES
BitMap 2, 320,256,#BITPLANES

; =============================
; read data for level data
; ============================

; tilemap
Select #CURRENT_LEVEL
  Case 0
    Restore MapData0
  Case 1
    Restore MapData1
  Case 2
    Restore MapData2
End Select

For i = 0 To #CELLS - 1
  Read tilemap(i)
Next i

; tile flags
Select #CURRENT_LEVEL
  Case 0
    Restore FlagData0
  Case 1
    Restore FlagData1
  Case 2
    Restore FlagData2
End Select

For i = 0 To #CELLS - 1
  Read tileflags(i)
Next i


; ===================================
; draw map on back- and front buffer
; ===================================
For y = 0 To #MAP_ROWS - 1
  For x = 0 To #MAP_COLS - 1
    idx    = y * #MAP_COLS + x
    tile.w = tilemap(idx)
    If tile = 0 Then Goto skipBuild
    sx.w = (tile MOD #SHEET_COLS) * #TILE_SIZE
    sy.w = tile / #SHEET_COLS
    sy   = sy * #TILE_SIZE
    Use BitMap 0
    GetaShape 0, sx, sy, #TILE_SIZE, #TILE_SIZE
    Use BitMap 1
    Blit 0, x * #TILE_SIZE, y * #TILE_SIZE

    Use BitMap 2
    Blit 0, x * #TILE_SIZE, y * #TILE_SIZE

    .skipBuild:
  Next x
Next y

; --- Pick a sprite tile from the sheet to use as the player sprite for now ---
Use BitMap 0
GetaShape 1, #SPRITE_SRCX, #SPRITE_SRCY, #TILE_SIZE, #TILE_SIZE
GetaSprite 0, 1
Free Shape 1

XINCLUDE "mapdata.ab3"
